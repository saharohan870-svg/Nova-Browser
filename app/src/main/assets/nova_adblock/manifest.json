{
  "manifest_version": 2,
  "name": "Nova Ad Blocker",
  "version": "2.0.0",
  "description": "EasyList and EasyPrivacy filter subscriptions for Nova Browser.",
  "applications": {
    "gecko": {
      "id": "nova-adblock@zorvi.browser",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "webNavigation",
    "tabs",
    "storage",
    "alarms",
    "http://*/*",
    "https://*/*",
    "https://easylist.to/*",
    "unlimitedStorage"
  ],
  "background": {
    "scripts": [
      "filter-engine.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}